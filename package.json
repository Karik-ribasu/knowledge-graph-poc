{
  "name": "knowledge-graph-poc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f docker/docker-compose.dev.yml down",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project core-coverage --coverage && node scripts/verify-core-coverage.mjs",
    "test:integration": "vitest run --project integration",
    "build": "pnpm -r run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "migrate:up": "pnpm --filter @kg/adapter-postgres run build && node --env-file=.env scripts/migrate.mjs up",
    "migrate:down": "pnpm --filter @kg/adapter-postgres run build && node --env-file=.env scripts/migrate.mjs down",
    "benchmark:recall": "pnpm build && node --env-file=.env packages/cli/dist/benchmark-recall.js",
    "kg": "node --env-file=.env packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
