# PostgreSQL (dev: docker-compose.dev.yml, test: port 5433)
DATABASE_URL=postgresql://kg:kg_dev_secret@localhost:5432/kg_dev

# Workspace root for corpus ingestion
KG_WORKSPACE=./corpus

# Embeddings: transformers | openai | hash (CI/tests)
EMBEDDING_PROVIDER=transformers

# Optional: OpenAI for benchmark A/B (adapter-embeddings-openai)
# OPENAI_API_KEY=sk-...

# Graph / ingest (future phases)
ENTITY_EXTRACTOR=rules

# Node environment
NODE_ENV=development
